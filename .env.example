# OCR provider token. The current implementation uses PaddleOCR's job API.
PADDLEOCR_TOKEN=

# Optional OpenAI-compatible vision LLM endpoint for visual row review.
# Enabling this layer improves field accuracy on handwritten rows by letting
# the model compare OCR text against the cropped source image.
VISION_LLM_API_URL=
VISION_LLM_API_KEY=
VISION_LLM_MODEL=

# Optional default .xls template path. Users can also upload a template in the UI.
LEDGER_TEMPLATE_PATH=
